# Copy this file to .env and replace placeholder values before running docker compose up.
# Generate WHATSAPP_API_KEY and WHATSAPP_JWT_SECRET with:
#   openssl rand -base64 48

# === REQUIRED ===
WHATSAPP_API_KEY=change-me-generate-with-openssl-rand-base64-48
WHATSAPP_JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
POSTGRES_USER=whatsapp
POSTGRES_PASS=change-me-use-openssl-rand

# === OPTIONAL ===
LOG_LEVEL=info
AUTH_LOGIN_RATE=
WEBHOOK_URL=
HOST=
PORT=8080

# Managed by docker-compose.yaml (set there, not here):
# - IS_POSTGRES=true
# - POSTGRES_HOST=postgres
# - POSTGRES_PORT=5432
# - API_BASE_URL=http://wa-bridge:8080/api
# - IS_HTTP=true
# - HTTP_BASE_URL=0.0.0.0:5777
